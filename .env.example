# Server-only. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Override this if the free-tier model available to your Google AI Studio project differs.
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudflare Workers AI generates copy and background scenes. Keep these server-only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
